# Número del propietario del bot (solo dígitos, con código de país). Requerido.
BOT_OWNER_NUMBER=591XXXXXXXX

# JID exacto del propietario (opcional, sobreescribe BOT_OWNER_NUMBER).
# Útil si WhatsApp te identifica con un LID en vez de tu número.
# Descúbrelo en los logs al enviar un comando: "comando recibido ... senderJid=...@lid"
# BOT_OWNER_JID=12345678901234@lid

# Número del bot, solo dígitos con código de país. Requerido solo en la primera
# ejecución para generar el código de vinculación (pairing code).
PHONE_NUMBER=591YYYYYYYY

# Zona horaria usada para interpretar y mostrar fechas/horas de los comandos.
TIMEZONE=America/La_Paz

# Ruta del archivo SQLite.
DATABASE_PATH=./data/bot.db

# Directorio donde se persisten las credenciales de sesión de WhatsApp.
AUTH_DIR=./auth

# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# Puerto del servidor HTTP (health check).
PORT=3000

# Linking method: code (pairing code, default) | qr (scan QR in terminal).
# Use qr as an alternative if the server rejects pairing-code registration.
# LINK_METHOD=code
