{
  "name": "nudge-bot",
  "version": "1.0.0",
  "description": "Bot de WhatsApp para grupos privados con recordatorios por comandos",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "recordatorios",
    "baileys"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hono/node-server": "^2.1.1",
    "baileys": "6.7.24",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "pino": "^10.3.1",
    "pino-pretty": "^13.2.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/hapi__boom": "^9.0.1",
    "@types/node": "^26.6.4",
    "@types/qrcode-terminal": "^0.12.2",
    "drizzle-kit": "^0.18.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
